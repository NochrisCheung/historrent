# Historrent — environment variables.
# Copy to `.env.local` (gitignored) for local development.
# Production / preview values are set in the Vercel dashboard.

# DeepSeek API — used by src/app/api/synthesise/route.ts to call deepseek-v4-flash.
# Server-side only. NEVER expose with the NEXT_PUBLIC_ prefix.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Upstash Redis — provisioned via Vercel Marketplace. The synthesis cache lives here.
# Optional in local development: when these are absent, the cache layer
# falls back to an in-process Map (resets on every `pnpm dev` restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
